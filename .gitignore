# Resolved environment: never committed for a package. Note it also hard-codes the
# local dev path to OITOOLS.jl, which is machine-specific.
Manifest.toml
/demos/Manifest.toml
/docs/Manifest.toml

# Documenter output (regenerate with `julia --project=docs docs/make.jl`)
/docs/build/

# Julia coverage / profiling artifacts
*.jl.cov
*.jl.*.cov
*.jl.mem
/deps/deps.jl

# Generated by test/phoebe_crosscheck/export_geometry.jl
/test/phoebe_crosscheck/data/

# Generated demo output
/demos/results/
/results/

# PythonCall/CondaPkg resolved environments — ~1.9 GB across the three project dirs, and
# entirely reproducible from the CondaPkg.toml specs.
.CondaPkg/
/demos/.CondaPkg/
/docs/.CondaPkg/

# Diagnostic figures written by the test suite under ROTIR_TEST_FIGURES=1. ~30 MB at the
# default 300 dpi, regenerated in ~20 s, and they churn on every matplotlib upgrade.
/test/figures/

# beta Lyr: the 2013 MIRC-X nights are large and not used by the default fit
# (DATASET=old). older_data/ — the 2006-2007 nights Zhao et al. fitted — is committed.
/demos/betlyr/*.oifits
/demos/betlyr/*.pdf

# The GUI's one-click save targets. Every one of them writes a FIXED name beside the working
# directory rather than opening a save dialog — the picker is a file CHOOSER, and inventing a
# save dialog for a one-click action is a different widget. `unique_path` then numbers rather
# than overwrites, so repeated saves ACCUMULATE (rotir_sky.png, rotir_sky-2.png, …) instead of
# replacing each other.
#
# test/gui/gui_click.sh runs from the repo root and exercises "Save view…", so every click-test
# run drops one of these here. Anchored to the root, which is where the launcher and the test
# both start: a rotir_*.png committed deliberately in a subdirectory still shows up.
/rotir_*.png
/rotir_*.fits
/rotir_*.toml
/rotirgui_session*.jl

# LaTeX build artifacts (notes/)
*.aux
*.log
*.out
*.synctex.gz
